numero = int(input("Digite um número: "))

print("\n=== TABUADA DE ADIÇÃO ===")
for i in range(1, 11):
    print(f"{numero} + {i} = {numero + i}")

print("\n=== TABUADA DE SUBTRAÇÃO ===")
for i in range(1, 11):
    print(f"{numero} - {i} = {numero - i}")

print("\n=== TABUADA DE MULTIPLICAÇÃO ===")
for i in range(1, 11):
    print(f"{numero} * {i} = {numero * i}")

print("\n=== TABUADA DE DIVISÃO ===")
for i in range(1, 11):
    print(f"{numero} / {i} = {numero / i:.2f}")